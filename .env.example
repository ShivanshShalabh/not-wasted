# Leave OCI_GENAI_ENABLED=false for the offline demo (deterministic local AI fallback).
OCI_GENAI_ENABLED=false
# config = ~/.oci/config API key | instance = instance principal | resource = resource principal (Container Instances / Functions)
OCI_AUTH=config
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_GENAI_REGION=us-chicago-1
OCI_GENAI_VISION_MODEL=meta.llama-4-maverick-17b-128e-instruct-fp8
OCI_GENAI_TEXT_MODEL=meta.llama-3.3-70b-instruct
OCI_GENAI_EMBED_MODEL=cohere.embed-v4.0
# Optional: free key from https://api.data.gov/signup for USDA FoodData Central (falls back to DEMO_KEY)
FDC_API_KEY=
